# Copy to .env for local development. Never put real credentials in this file.
APP_ENV=development
LOG_LEVEL=INFO
TIMEZONE=Asia/Seoul
DRY_RUN=true

# PostgreSQL. Docker Compose uses these values to configure its local database.
POSTGRES_DB=seoul_mens_daily_edit
POSTGRES_USER=seoul_mens_daily_edit
POSTGRES_PASSWORD=

# Required for host-based commands. Docker Compose supplies this value to the app.
DATABASE_URL=

# V1 image provider. Cloudflare Workers AI is the default.
IMAGE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
CLOUDFLARE_IMAGE_SIZE=1080x1350

# OpenAI Image API is optional and used only when IMAGE_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1088x1360
GENERATED_IMAGES_DIR=data/generated
OPENAI_VISION_MODEL=

# Weather provider. Choose a documented provider in PHASE 2.
WEATHER_API_BASE_URL=
WEATHER_API_KEY=

# Official Meta/Instagram API. Configure only in PHASE 10.
META_API_VERSION=
META_INSTAGRAM_USER_ID=
META_ACCESS_TOKEN=

# Public HTTPS origin from which Instagram can fetch generated media.
MEDIA_PUBLIC_BASE_URL=
